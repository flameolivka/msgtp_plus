{
  "manifest_version": 3,
  "name": "MSGTP+",
  "version": "1.8.3",
  "minimum_chrome_version": "114",
  "description": "Расширение для работы с чатами MSGTP+. Разработано @fl_rossi",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "action": {
    "default_title": "MSGTP+ — настройки",
    "default_popup": "popup/popup.html"
  },
  "background": { "service_worker": "scripts/background.js" },
  "host_permissions": [
    "https://*.langame.ru/*",
    "https://*.langame-pr.ru/*",
    "https://*.langame-soft.ru/*",
    "https://*.langamepro.ru/*",
    "https://*.cls.expert/*",
    "https://*.cc.f5center.com/*",
    "https://*.langamesftw.ru/*"
  ],
  "optional_host_permissions": ["https://*/*"]
}

